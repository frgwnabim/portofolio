---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBanner from '../components/SectionBanner.astro';
import { site, sections } from '../data/site';
import { certificates, type Certificate } from '../data/certificates';

const categoryLabel: Record<NonNullable<Certificate['category']>, string> = {
  se: 'Software Engineering',
  da: 'Data Analytics',
  other: 'Lainnya',
};

// Filter hanya muncul kalau sertifikatnya berasal dari lebih dari satu kategori
const categories = [...new Set(certificates.map((c) => c.category ?? 'other'))];
const showFilter = categories.length > 1;

// Inisial penerbit untuk kartu yang belum punya gambar
const initialsOf = (text: string) =>
  text
    .split(/\s+/)
    .filter((word) => /[a-z0-9]/i.test(word))
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');

const isPdf = (path: string) => /\.pdf($|[?#])/i.test(path);
---

<BaseLayout
  title={`Sertifikat | ${site.name}`}
  description={`Daftar sertifikasi dan pelatihan ${site.name}.`}
>
  <section class="part" data-part="cert">
    <SectionBanner
      number="01"
      title={sections.certificates.title}
      subtitle={certificates.length > 0 ? `${certificates.length} sertifikat` : 'Sertifikasi & pelatihan'}
      icon="award"
    />

    <div class="container part-body">
      <div class="toolbar">
        <a class="back" href="/#tentang">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
          Kembali ke Tentang saya
        </a>

        {
          showFilter && (
            <div class="filters" role="group" aria-label="Filter kategori sertifikat">
              <button type="button" class="chip" data-filter="all" aria-pressed="true">
                Semua
              </button>
              {categories.map((cat) => (
                <button type="button" class="chip" data-filter={cat} aria-pressed="false">
                  {categoryLabel[cat]}
                </button>
              ))}
            </div>
          )
        }
      </div>

      {
        certificates.length === 0 ? (
          <p class="empty">
            Belum ada sertifikat. Tambahkan lewat file <code>src/data/certificates.ts</code>.
          </p>
        ) : (
          <ul class="cert-grid">
            {certificates.map((cert) => {
              const href = cert.link || cert.image;
              const category = cert.category ?? 'other';
              // PDF tidak bisa tampil di <img>, jadi pakai thumbnail desain
              const hasImage = !!cert.image && !isPdf(cert.image);
              const fileType = href && isPdf(href) ? 'PDF' : null;
              return (
                <li class="cert" data-category={category}>
                  <div class="thumb">
                    {hasImage ? (
                      <img src={cert.image} alt={`Sertifikat ${cert.title}`} loading="lazy" decoding="async" />
                    ) : (
                      <div class="thumb-art" aria-hidden="true">
                        <div class="paper">
                          <span class="paper-label">Certificate</span>
                          <span class="paper-initials">{initialsOf(cert.issuer)}</span>
                          <span class="paper-line paper-line--lg" />
                          <span class="paper-line" />
                          <span class="paper-line paper-line--sm" />
                          <span class="seal">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="9" r="6" />
                              <path d="m8.5 13.8-1.5 7.2 5-3 5 3-1.5-7.2" />
                            </svg>
                          </span>
                        </div>
                        <span class="thumb-year">{cert.date}</span>
                        {fileType && <span class="thumb-type">{fileType}</span>}
                      </div>
                    )}
                  </div>

                  <div class="body">
                    <div class="meta">
                      <span class="issuer">{cert.issuer}</span>
                      <span class="date">{cert.date}</span>
                    </div>

                    <h2>
                      {href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer">
                          {cert.title}
                        </a>
                      ) : (
                        cert.title
                      )}
                    </h2>

                    {cert.credentialId && <p class="cred">ID: {cert.credentialId}</p>}

                    {cert.skills && cert.skills.length > 0 && (
                      <ul class="tags">
                        {cert.skills.slice(0, 4).map((skill) => (
                          <li class="tag">{skill}</li>
                        ))}
                      </ul>
                    )}

                    {href && (
                      <span class="open" aria-hidden="true">
                        Lihat sertifikat
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17 17 7M9 7h8v8" />
                        </svg>
                      </span>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .part {
    min-height: calc(100vh - var(--header-h));
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    transition: color 0.2s var(--ease);
  }

  .back:hover {
    color: var(--brand-strong);
  }

  .back svg {
    width: 1rem;
    height: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--ink-2);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .chip:hover {
    border-color: var(--brand);
    color: var(--brand-strong);
  }

  .chip[aria-pressed='true'] {
    background: var(--part-cert);
    border-color: transparent;
    color: #fff;
  }

  .cert-grid {
    display: grid;
    gap: clamp(0.75rem, 2.2vw, 1.5rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1000px) {
    .cert-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cert {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .cert[hidden] {
    display: none;
  }

  .cert:hover,
  .cert:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-strong);
  }

  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s var(--ease);
  }

  .cert:hover .thumb img {
    transform: scale(1.04);
  }

  /* Thumbnail desain seragam (dipakai kalau sertifikat tidak punya gambar) */
  .thumb-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    background:
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.18) 1px, transparent 0) 0 0 / 16px 16px,
      radial-gradient(80% 70% at 85% 10%, rgba(255, 255, 255, 0.22), transparent 60%),
      var(--part-cert);
    overflow: hidden;
  }

  .thumb-art::before,
  .thumb-art::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .thumb-art::before {
    width: 70%;
    aspect-ratio: 1;
    left: -22%;
    bottom: -40%;
  }

  .thumb-art::after {
    width: 45%;
    aspect-ratio: 1;
    right: -12%;
    top: -20%;
  }

  .paper {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 62%;
    aspect-ratio: 1.414 / 1;
    padding: 0.9rem 1rem;
    background: #fff;
    border-radius: 6px;
    outline: 1.5px solid #c9e6e4;
    outline-offset: -7px;
    box-shadow: 0 18px 30px -12px rgba(4, 45, 55, 0.55), 0 2px 6px rgba(4, 45, 55, 0.2);
    transform: rotate(-3deg);
    transition: transform 0.5s var(--ease);
  }

  .cert:hover .paper {
    transform: rotate(0deg) scale(1.05);
  }

  .paper-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #117c93;
  }

  .paper-initials {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(120deg, #117c93, #14a098);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .paper-line {
    display: block;
    width: 55%;
    height: 4px;
    border-radius: 999px;
    background: #e3eef0;
  }

  .paper-line--lg {
    width: 72%;
    background: #cfe3e6;
  }

  .paper-line--sm {
    width: 38%;
  }

  .seal {
    position: absolute;
    right: -0.7rem;
    bottom: -0.7rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #f7c948, #e8a317);
    color: #fff;
    box-shadow: 0 6px 14px -4px rgba(120, 70, 0, 0.5);
    border: 2px solid #fff;
  }

  .seal svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .thumb-year,
  .thumb-type {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
  }

  .thumb-year {
    left: 0.75rem;
  }

  .thumb-type {
    right: 0.75rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
    padding: 1.15rem 1.25rem 1.3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3rem 0.75rem;
    font-size: 0.8rem;
  }

  .issuer {
    font-weight: 700;
    color: var(--brand-strong);
  }

  .date {
    color: var(--ink-3);
  }

  .body h2 {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .body h2 a {
    color: var(--ink);
  }

  /* Seluruh kartu bisa diklik */
  .body h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .body h2 a:focus-visible {
    outline: none;
  }

  .cert:has(h2 a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .cred {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand-strong);
  }

  .open svg {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.25s var(--ease);
  }

  .cert:hover .open svg {
    transform: translate(2px, -2px);
  }

  /* Versi ringkas untuk grid 2 kolom di layar kecil */
  @media (max-width: 639px) {
    .cert {
      border-radius: var(--radius);
    }

    .body {
      gap: 0.4rem;
      padding: 0.75rem 0.8rem 0.85rem;
    }

    .meta {
      flex-direction: column;
      font-size: 0.7rem;
    }

    .body h2 {
      font-size: 0.9rem;
    }

    .cred {
      font-size: 0.68rem;
    }

    .tags .tag {
      padding: 0.16rem 0.45rem;
      font-size: 0.64rem;
    }

    .tags li:nth-child(n + 3) {
      display: none;
    }

    .open {
      font-size: 0.74rem;
    }

    .paper {
      width: 68%;
      gap: 0.3rem;
      padding: 0.55rem 0.6rem;
      outline-offset: -5px;
    }

    .paper-label {
      font-size: 0.42rem;
    }

    .paper-initials {
      font-size: 0.95rem;
    }

    .paper-line {
      height: 3px;
    }

    .seal {
      width: 1.7rem;
      height: 1.7rem;
      right: -0.5rem;
      bottom: -0.5rem;
    }

    .seal svg {
      width: 0.85rem;
      height: 0.85rem;
    }

    .thumb-year,
    .thumb-type {
      top: 0.45rem;
      padding: 0.12rem 0.4rem;
      font-size: 0.6rem;
    }

    .thumb-year {
      left: 0.45rem;
    }

    .thumb-type {
      right: 0.45rem;
    }
  }

  .empty {
    padding: 2rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-3);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--brand-strong);
  }
</style>

<script>
  /* Filter kategori sertifikat */
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.cert'));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.category !== filter;
      });
    });
  });
</script>
