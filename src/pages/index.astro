---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Certificates from '../components/Certificates.astro';
import Contact from '../components/Contact.astro';
import { sections } from '../data/site';
import { softwareProjects, dataProjects } from '../data/projects';
---

<BaseLayout>
  <Hero />

  <About />

  <ProjectSection
    id={sections.software.id}
    number="02"
    eyebrow={sections.software.eyebrow}
    title={sections.software.title}
    description={sections.software.description}
    accent="se"
    projects={softwareProjects}
  />

  <ProjectSection
    id={sections.data.id}
    number="03"
    eyebrow={sections.data.eyebrow}
    title={sections.data.title}
    description={sections.data.description}
    accent="da"
    projects={dataProjects}
  />

  <Certificates number="04" />

  <Contact />
</BaseLayout>

