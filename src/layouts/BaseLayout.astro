---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;
// .htaccess membuang akhiran .html, jadi canonical ikut tanpa .html
const canonical = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, ''),
  Astro.site ?? site.url
).href;
const ogImage = new URL(site.seo.ogImage, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <!-- Ikon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#f3f8fd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081524" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    <!-- Data terstruktur untuk mesin pencari -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        jobTitle: site.role,
        email: `mailto:${site.email}`,
        url: site.url,
        sameAs: [site.socials.github, site.socials.linkedin, site.socials.instagram].filter(Boolean),
      })}
    />

    <!-- Kalau JavaScript mati, konten tetap tampil (animasi masuk dilewati) -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Set tema sebelum render supaya tidak ada kedipan putih -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#konten">Lompat ke konten utama</a>
    <Header />
    <main id="konten">
      <slot />
    </main>
    <Footer />

    <script>
      /* ------------------------------------------------------------------
         Script global: animasi reveal + highlight menu aktif.
         Ditulis vanilla JS supaya ringan dan tidak butuh framework di client.
      ------------------------------------------------------------------ */
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = document.querySelectorAll<HTMLElement>('.reveal');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        revealables.forEach((el) => revealObserver.observe(el));
      }

      // Tandai menu yang sedang dilihat
      const navAnchors = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
      );
      const watched = navAnchors
        .map((a) => a.getAttribute('href') || '')
        .filter((href) => href.startsWith('#'))
        .map((href) => document.querySelector<HTMLElement>(href))
        .filter((el): el is HTMLElement => Boolean(el));

      if (watched.length && 'IntersectionObserver' in window) {
        const spyObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const id = `#${entry.target.id}`;
              navAnchors.forEach((a) =>
                a.classList.toggle('is-active', a.getAttribute('href') === id)
              );
            });
          },
          { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
        );
        watched.forEach((el) => spyObserver.observe(el));
      }
    </script>
  </body>
</html>
