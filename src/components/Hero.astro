---
import { site } from '../data/site';

// Kata di dalam kurung kurawal pada site.hero.headline diberi warna gradient.
const headlineParts = site.hero.headline.split(/(\{[^}]+\})/g).filter(Boolean);

const hasResume = Boolean(site.socials.resume);
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      {
        site.availability && (
          <p class="availability reveal">
            <span class="dot" aria-hidden="true" />
            {site.availability}
          </p>
        )
      }

      <h1 class="reveal" style="--reveal-delay:60ms">
        {
          headlineParts.map((part) =>
            part.startsWith('{') && part.endsWith('}') ? (
              <span class="gradient-text">{part.slice(1, -1)}</span>
            ) : (
              <span>{part}</span>
            )
          )
        }
      </h1>

      <p class="hero-sub reveal" style="--reveal-delay:120ms">{site.hero.subheadline}</p>

      <div class="hero-actions reveal" style="--reveal-delay:180ms">
        <a class="btn btn--primary" href="#software-engineering">
          Lihat project
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12l7 7 7-7"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="3"></rect>
            <path d="m3.5 7.5 8.5 6 8.5-6"></path>
          </svg>
          Kirim email
        </a>
        {
          hasResume && (
            <a class="btn btn--ghost" href={site.socials.resume} target="_blank" rel="noopener">
              Unduh CV
            </a>
          )
        }
      </div>

      {
        site.location && (
          <p class="hero-meta reveal" style="--reveal-delay:220ms">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {site.location}
          </p>
        )
      }

      {
        site.stats.length > 0 && (
          <ul class="hero-stats reveal" style="--reveal-delay:260ms">
            {site.stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Ilustrasi dekoratif: kartu kode + kartu grafik -->
    <div class="hero-visual reveal" style="--reveal-delay:200ms" aria-hidden="true">
      <div class="glow"></div>

      <div class="code-card">
        <div class="window-bar">
          <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
          <span class="file-name">profil.ts</span>
        </div>
        <pre><code><span class="c-key">const</span> <span class="c-var">abim</span> = {'{'}
  <span class="c-prop">peran</span>: [<span class="c-str">'Software Engineer'</span>,
          <span class="c-str">'Data Analyst'</span>],
  <span class="c-prop">fokus</span>: <span class="c-str">'produk yang dipakai'</span>,
  <span class="c-prop">prinsip</span>: <span class="c-str">'rapi, terukur, jelas'</span>,
{'}'};</code></pre>
      </div>

      <div class="chart-card">
        <div class="chart-head">
          <span class="chart-title">Insight bulanan</span>
          <span class="chart-trend">+24%</span>
        </div>
        <svg class="chart" viewBox="0 0 160 62" role="presentation">
          <defs>
            <linearGradient id="barGrad" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0%" stop-color="var(--teal-500)" />
              <stop offset="100%" stop-color="var(--blue-400)" />
            </linearGradient>
          </defs>
          <g fill="url(#barGrad)">
            <rect x="2" y="38" width="14" height="22" rx="4"></rect>
            <rect x="24" y="28" width="14" height="32" rx="4"></rect>
            <rect x="46" y="32" width="14" height="28" rx="4"></rect>
            <rect x="68" y="18" width="14" height="42" rx="4"></rect>
            <rect x="90" y="24" width="14" height="36" rx="4"></rect>
            <rect x="112" y="10" width="14" height="50" rx="4"></rect>
            <rect x="134" y="4" width="14" height="56" rx="4"></rect>
          </g>
        </svg>
      </div>

      <div class="pill-card">
        <span class="pill-dot"></span>
        Deploy berhasil
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 38rem;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: flex-start;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-sm);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal-500);
    flex: none;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--teal-400);
    opacity: 0.5;
    animation: ping 2.4s var(--ease) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  h1 {
    font-size: clamp(2.25rem, 1.3rem + 4.2vw, 3.9rem);
    font-weight: 800;
    letter-spacing: -0.032em;
    line-height: 1.08;
  }

  .hero-sub {
    font-size: clamp(1.02rem, 0.98rem + 0.3vw, 1.16rem);
    color: var(--ink-2);
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.35rem;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  .hero-meta svg {
    width: 1rem;
    height: 1rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 4vw, 2.75rem);
    margin-top: 0.9rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hero-stats strong {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .hero-stats span {
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  /* --- Ilustrasi --- */
  .hero-visual {
    position: relative;
    display: none;
    isolation: isolate;
    padding-bottom: 2.5rem;
  }

  .glow {
    position: absolute;
    inset: -12% -8% 4% -4%;
    z-index: -1;
    background: var(--gradient-brand);
    filter: blur(58px);
    opacity: 0.28;
    border-radius: 50%;
  }

  .code-card {
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(-1.1deg);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.95rem;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border);
  }

  .window-bar span[class^='dot-'] {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
  }

  .dot-red {
    background: #ff6b6b;
  }
  .dot-yellow {
    background: #ffc34d;
  }
  .dot-green {
    background: #45cf8e;
  }

  .file-name {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .code-card pre {
    margin: 0;
    padding: 1.15rem 1.25rem 1.35rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.79rem;
    line-height: 1.85;
    color: var(--ink-2);
  }

  .c-key {
    color: var(--blue-600);
    font-weight: 600;
  }
  .c-var {
    color: var(--ink);
    font-weight: 600;
  }
  .c-prop {
    color: var(--teal-600);
  }
  .c-str {
    color: var(--blue-500);
  }

  :global(:root[data-theme='dark']) .c-key {
    color: #8ac8ff;
  }
  :global(:root[data-theme='dark']) .c-prop {
    color: var(--teal-300);
  }
  :global(:root[data-theme='dark']) .c-str {
    color: #9fd0ff;
  }

  .chart-card {
    position: absolute;
    left: -1.75rem;
    bottom: 0;
    width: 13.5rem;
    padding: 0.9rem 1rem 0.8rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transform: rotate(1.6deg);
    animation: float 7s ease-in-out infinite;
  }

  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.55rem;
  }

  .chart-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--ink);
  }

  .chart-trend {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--teal-600);
  }

  :global(:root[data-theme='dark']) .chart-trend {
    color: var(--teal-300);
  }

  .chart {
    width: 100%;
    height: auto;
  }

  .pill-card {
    position: absolute;
    right: -0.75rem;
    top: -1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink);
    animation: float 6s ease-in-out infinite reverse;
  }

  .pill-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #45cf8e;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(1.6deg);
    }
    50% {
      transform: translateY(-9px) rotate(1.6deg);
    }
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .hero-visual {
      display: block;
    }
  }
</style>
