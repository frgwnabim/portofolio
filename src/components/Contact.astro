---
import { site } from '../data/site';

const links = [
  site.socials.github && {
    label: 'GitHub',
    value: site.socials.github.replace(/^https?:\/\/(www\.)?/, ''),
    href: site.socials.github,
    icon: 'github',
  },
  site.socials.linkedin && {
    label: 'LinkedIn',
    value: site.socials.linkedin.replace(/^https?:\/\/(www\.)?/, ''),
    href: site.socials.linkedin,
    icon: 'linkedin',
  },
  site.socials.instagram && {
    label: 'Instagram',
    value: site.socials.instagram.replace(/^https?:\/\/(www\.)?/, ''),
    href: site.socials.instagram,
    icon: 'instagram',
  },
].filter(Boolean) as { label: string; value: string; href: string; icon: string }[];
---

<section class="section" id="kontak">
  <div class="container">
    <div class="contact-card reveal">
      <div class="contact-copy">
        <div class="section-title">
          <span class="section-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <path d="m3.5 7.5 8.5 6 8.5-6" />
            </svg>
          </span>
          <h2>{site.contact.title}</h2>
        </div>
        {site.contact.description && <p>{site.contact.description}</p>}

        <div class="contact-actions">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3"></rect>
              <path d="m3.5 7.5 8.5 6 8.5-6"></path>
            </svg>
            {site.email}
          </a>
          <button class="btn btn--ghost" type="button" id="copy-email" data-email={site.email}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
              <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15"></path>
            </svg>
            <span class="copy-label">Salin email</span>
          </button>
        </div>
      </div>

      {
        links.length > 0 && (
          <ul class="contact-links">
            {links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <span class="link-icon" aria-hidden="true">
                    {link.icon === 'github' && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.2c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.73.08-.73 1.21.08 1.84 1.25 1.84 1.25 1.08 1.84 2.83 1.31 3.52 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.4 1.24-3.24-.12-.3-.54-1.53.12-3.18 0 0 1.01-.33 3.3 1.24a11.4 11.4 0 0 1 6.01 0c2.29-1.57 3.3-1.24 3.3-1.24.66 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.24 0 4.63-2.81 5.65-5.49 5.95.43.38.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5z" />
                      </svg>
                    )}
                    {link.icon === 'linkedin' && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.2 1.46-2.2 2.97V21H9z" />
                      </svg>
                    )}
                    {link.icon === 'instagram' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                  </span>
                  <span class="link-text">
                    <strong>{link.label}</strong>
                    <small>{link.value}</small>
                  </span>
                  <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 120% at 100% 0%, var(--brand-soft), transparent 62%);
    pointer-events: none;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    position: relative;
    max-width: 34rem;
  }



  .contact-actions .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .contact-copy p {
    color: var(--ink-2);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.4rem;
  }

  .contact-links {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    align-content: start;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    color: var(--ink);
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .contact-links a:hover {
    transform: translateX(4px);
    border-color: var(--brand);
    background: var(--surface);
  }

  .link-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    flex: none;
    border-radius: 11px;
    background: var(--gradient-brand);
    color: #fff;
  }

  .link-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .link-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    line-height: 1.35;
    min-width: 0;
  }

  .link-text strong {
    font-size: 0.94rem;
    font-weight: 700;
  }

  .link-text small {
    font-size: 0.78rem;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    color: var(--ink-3);
    flex: none;
  }

  @media (min-width: 900px) {
    .contact-card {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }
</style>

<script>
  // Tombol salin email
  const copyBtn = document.getElementById('copy-email');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email;
    const label = copyBtn.querySelector<HTMLElement>('.copy-label');
    if (!email || !label) return;

    const original = 'Salin email';
    try {
      await navigator.clipboard.writeText(email);
      label.textContent = 'Tersalin';
    } catch (e) {
      label.textContent = email;
    }
    window.setTimeout(() => {
      label.textContent = original;
    }, 1800);
  });
</script>
