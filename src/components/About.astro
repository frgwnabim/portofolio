---
import { site } from '../data/site';
---

<section class="section" id="tentang">
  <div class="container about-grid">
    <div class="about-copy reveal">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
          </svg>
        </span>
        <h2>Tentang saya</h2>
      </div>
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="skills reveal" style="--reveal-delay:120ms">
      {
        site.skills.map((group) => (
          <div class="skill-card" data-accent={group.accent}>
            <div class="skill-head">
              <span class="skill-icon" aria-hidden="true">
                {group.accent === 'se' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m8 17-5-5 5-5M16 7l5 5-5 5M13.5 4l-3 16" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <path d="M7 15v3M12 10v8M17 6v12" />
                  </svg>
                )}
              </span>
              <h3>{group.group}</h3>
            </div>
            <ul>
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(2rem, 4.5vw, 3.5rem);
    align-items: start;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 36rem;
  }

  .about-copy .section-title {
    margin-bottom: 0.4rem;
  }

  .about-copy p {
    color: var(--ink-2);
  }

  .skills {
    display: grid;
    gap: 1.1rem;
  }

  .skill-card {
    --chip: var(--gradient-se);
    padding: 1.35rem 1.4rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .skill-card[data-accent='da'] {
    --chip: var(--gradient-da);
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .skill-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .skill-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border-radius: 12px;
    background: var(--chip);
    color: #fff;
  }

  .skill-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .skill-head h3 {
    font-size: 1.05rem;
  }

  .skill-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    }
  }
</style>
