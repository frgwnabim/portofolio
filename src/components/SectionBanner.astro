---
interface Props {
  number: string;
  title: string;
  subtitle?: string;
  icon: 'user' | 'code' | 'chart' | 'mail' | 'award';
}

const { number, title, subtitle, icon } = Astro.props;
---

<div class="container banner-wrap">
  <div class="banner banner-inner">
    <span class="banner-num" aria-hidden="true">{number}</span>
    <span class="banner-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {icon === 'user' && (
          <>
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
          </>
        )}
        {icon === 'code' && <path d="m8 17-5-5 5-5M16 7l5 5-5 5M13.5 4l-3 16" />}
        {icon === 'chart' && (
          <>
            <path d="M3 3v18h18" />
            <path d="M7 15v3M12 10v8M17 6v12" />
          </>
        )}
        {icon === 'award' && (
          <>
            <circle cx="12" cy="9" r="6" />
            <path d="m8.2 13.6-1.7 7.4 5.5-3 5.5 3-1.7-7.4" />
          </>
        )}
        {icon === 'mail' && (
          <>
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="m3.5 7.5 8.5 6 8.5-6" />
          </>
        )}
      </svg>
    </span>
    <div class="banner-text">
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
  </div>
</div>

<style>
  /* Banner selebar isi bagian (bukan full-bleed), supaya judul dan konten
     rata di kiri-kanan yang sama */
  .banner-wrap {
    position: relative;
    z-index: 1;
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }

  .banner {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--part-bg);
    color: #fff;
    box-shadow: var(--part-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  /* Pola titik halus supaya banner tidak terasa datar */
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: linear-gradient(90deg, transparent 35%, #000 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 35%, #000 100%);
    pointer-events: none;
  }

  .banner-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.5vw, 1.4rem);
    padding: clamp(1.25rem, 3.5vw, 2.1rem) clamp(1.15rem, 3.5vw, 2.25rem);
  }

  .banner-num {
    font-size: clamp(2.6rem, 1.8rem + 3.4vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.38);
    font-variant-numeric: tabular-nums;
  }

  .banner-icon {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 2.3rem + 1.6vw, 3.4rem);
    height: clamp(2.75rem, 2.3rem + 1.6vw, 3.4rem);
    flex: none;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .banner-icon svg {
    width: 52%;
    height: 52%;
  }

  .banner-text {
    min-width: 0;
  }

  .banner h2 {
    color: #fff;
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 2.75rem);
    line-height: 1.12;
  }

  .banner p {
    margin-top: 0.2rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
  }

  @media (max-width: 420px) {
    .banner-icon {
      display: none;
    }
  }
</style>
