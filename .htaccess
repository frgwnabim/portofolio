# =============================================================================
# KONFIGURASI APACHE / LITESPEED UNTUK HOSTINGER
# File ini otomatis ikut ter-copy ke folder dist/ saat `npm run build`.
# Upload apa adanya ke public_html.
# =============================================================================

# ---------- 1. Halaman utama & halaman error --------------------------------
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------- 2. Paksa HTTPS ------------------------------------------------
  # Aktif setelah SSL di hPanel selesai dipasang (biasanya otomatis).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---------- 3. Pilih SATU: dengan www atau tanpa www -----------------------
  # Default: paksa TANPA www (domain.com). Hapus tanda # di 2 baris ini kalau
  # kamu justru ingin selalu pakai www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Kebalikannya (paksa PAKAI www). Aktifkan hanya kalau blok di atas dimatikan.
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # ---------- 4. URL bersih tanpa .html -------------------------------------
  # /tentang akan menampilkan /tentang.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Hilangkan .html dari alamat kalau ada yang mengetiknya langsung
  # (index.html dan 404.html sengaja dilewati)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %1 !^(index|404)$ [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ---------- 5. Kompresi ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# ---------- 6. Cache browser -------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  # HTML jangan di-cache lama supaya update konten langsung kelihatan
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Aset hasil build Astro punya nama unik (hash), aman di-cache selamanya
  <FilesMatch "\.(css|js|woff2|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---------- 7. Header keamanan dasar --------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
</IfModule>

# ---------- 8. Tipe file tambahan -------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- 9. Sembunyikan file yang tidak perlu diakses publik --------------
<FilesMatch "(^\.|\.(md|json5|map|log|bak)$)">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

# Matikan daftar isi folder
Options -Indexes
